# ---- Database ----
DATABASE_URL=postgresql://gem_user:gem_password@localhost:5432/gem_compliance

# ---- Security ----
SECRET_KEY=change-this-to-a-long-random-string-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- App ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- File storage (local for MVP) ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ---- AI service (Day 2: Tender Intelligence module) ----
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6KOXrZVHrfQY3aBuLc1ZkM9dYVBc2-_79LIHt2gHRKPCw
AI_MODEL=gemini-3.6-flash
MAX_AI_INPUT_CHARS=60000

# ---- Notifications (Day 6: bidder alerts) ----
# Leave NOTIFICATIONS_ENABLED=false to keep the app running with no SMTP
# setup - alerts are still recorded (status="skipped") so nothing breaks.
# Flip to true and fill in SMTP_* to actually email bidders.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@gem-compliance.local
SMTP_USE_TLS=true
# SMS is not implemented yet - needs a paid gateway (Twilio/MSG91/etc).
SMS_ENABLED=false
